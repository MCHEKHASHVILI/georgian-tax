{
    "name": "mchekhashvili/georgian-tax",
    "description": "Domain model and pipeline for applying the Tax Code of Georgia to transactions: income tax, profit tax, VAT, excise, import tax and property tax.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "GeorgianTax\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GeorgianTax\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit tests"
    },
    "config": {
        "platform": {
            "php": "8.4.27"
        }
    }
}
