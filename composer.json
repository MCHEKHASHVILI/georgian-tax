{
    "name": "mchekhashvili/georgian-tax",
    "description": "Georgia's tax law for Laravel on mchekhashvili/tax-legislation: income tax, profit tax, VAT, excise, import tax and property tax as pipelines of rules citing the Tax Code.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "tax",
        "georgia",
        "vat",
        "income-tax",
        "excise",
        "pipeline"
    ],
    "require": {
        "php": "^8.4",
        "illuminate/bus": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/events": "^12.0 || ^13.0",
        "illuminate/pipeline": "^12.0 || ^13.0",
        "illuminate/queue": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "mchekhashvili/countries": "^1.0@dev",
        "mchekhashvili/money": "^1.0@dev",
        "mchekhashvili/tax-legislation": "^1.0@dev"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "GeorgianTax\\": "src/",
            "GeorgianTax\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GeorgianTax\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "GeorgianTax\\GeorgianTaxServiceProvider"
            ],
            "aliases": {
                "GeorgianTax": "GeorgianTax\\Facades\\GeorgianTax"
            }
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
